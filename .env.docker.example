# ============================================================================
# Variables para `docker compose --env-file .env.docker ...`
#
# Copia este archivo a `.env.docker`, rellena los valores y NO lo subas a git:
#   Copy-Item .env.docker.example .env.docker
#
# La base arranca vacía. El backend aplica las migraciones y crea la presidencia
# con PRESIDENTE_CORREO. No ejecuta el seed de demostración.
# ============================================================================

# --- PostgreSQL del contenedor ---------------------------------------------
POSTGRES_DB=clasesconjuntas
POSTGRES_USER=clasesconjuntas
# Usa una contraseña larga y sin caracteres que rompan una URL (por ejemplo @ : / ?)
POSTGRES_PASSWORD=cambia-esta-contrasena-larga

# --- Autenticación (obligatoria) -------------------------------------------
# Mínimo 16 caracteres. Cambiarlo invalida los códigos de verificación ya
# impresos en certificados.
JWT_SECRET=cambia-esta-clave-de-al-menos-16-caracteres
JWT_EXPIRES_IN=1d
INVITATION_EXPIRES_IN=7d

# --- URL pública ------------------------------------------------------------
# Deben ser la URL real del servidor, no localhost. El QR del certificado usa
# URL_PUBLICA; si la cambias después de emitir, los QR anteriores dejan de valer.
FRONTEND_URL=https://demo.ejemplo.org
URL_PUBLICA=https://demo.ejemplo.org

# --- Correo saliente --------------------------------------------------------
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ejemplo.org
#MAIL_FROM_CERTIFICADOS=

# --- Presidencia inicial ----------------------------------------------------
# En una base vacía se crea esta cuenta y se le envía una contraseña provisional.
PRESIDENTE_CORREO=presidencia@ejemplo.org

# --- Opcionales -------------------------------------------------------------
TZ=UTC
# HSTS solo se envía con NODE_ENV=production; pon false para desactivarlo.
HSTS=true
#REVISION_DIAS_ANTELACION=7
#URLS_PERMITIDAS=
#ENVIOS_INTERVALO_MS=60000
