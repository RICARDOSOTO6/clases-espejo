generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institucion {
  id                  Int                          @id @default(autoincrement())
  nombre              String
  pais                String
  correoInstitucional String                       @map("correo_institucional")
  activa              Boolean
  creadoEn            DateTime                     @default(now()) @map("creado_en")
  actualizadoEn       DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  agentes             AgenteInternacionalizacion[]
  docentesInstitucion DocenteInstitucion[]
  materias            Materia[]
  solicitudesDestino  SolicitudClaseEspejo[]
  invitaciones        Invitacion[]

  @@map("INSTITUCION")
}

model Usuario {
  id              Int                         @id @default(autoincrement())
  nombres         String
  apellidoPaterno String                      @map("apellido_paterno")
  apellidoMaterno String                      @map("apellido_materno")
  dni             String                      @unique
  correo          String                      @unique
  passwordHash    String?                     @map("password_hash")
  activo          Boolean                     @default(true)
  creadoEn        DateTime                    @default(now()) @map("creado_en")
  actualizadoEn   DateTime                    @default(now()) @updatedAt @map("actualizado_en")
  agente          AgenteInternacionalizacion?
  docente         Docente?

  @@map("USUARIO")
}

model Invitacion {
  id             Int         @id @default(autoincrement())
  correo         String
  numeroEmpleado String      @map("numero_empleado")
  institucionId  Int         @map("institucion_id")
  token          String      @unique
  expiracion     DateTime
  usadaEn        DateTime?   @map("usada_en")
  creadoEn       DateTime    @default(now()) @map("creado_en")
  institucion    Institucion @relation(fields: [institucionId], references: [id])

  @@map("INVITACION")
}

model AgenteInternacionalizacion {
  id            Int                 @id @default(autoincrement())
  usuarioId     Int                 @unique @map("usuario_id")
  institucionId Int                 @map("institucion_id")
  cargo         String
  institucion   Institucion         @relation(fields: [institucionId], references: [id])
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  revisiones    RevisionSolicitud[]

  @@map("AGENTE_INTERNACIONALIZACION")
}

model Docente {
  id             Int                  @id @default(autoincrement())
  usuarioId      Int                  @unique @map("usuario_id")
  gradoAcademico String               @map("grado_academico")
  especialidad   String
  usuario        Usuario              @relation(fields: [usuarioId], references: [id])
  creadoEn       DateTime             @default(now()) @map("creado_en")
  actualizadoEn  DateTime             @default(now()) @updatedAt @map("actualizado_en")
  instituciones  DocenteInstitucion[]

  @@map("DOCENTE")
}

model DocenteInstitucion {
  id             Int                 @id @default(autoincrement())
  docenteId      Int                 @map("docente_id")
  institucionId  Int                 @map("institucion_id")
  numeroEmpleado String              @map("numero_empleado")
  activo         Boolean
  creadoEn       DateTime            @default(now()) @map("creado_en")
  actualizadoEn  DateTime            @default(now()) @updatedAt @map("actualizado_en")
  asignaciones   AsignacionDocente[]
  docente        Docente             @relation(fields: [docenteId], references: [id])
  institucion    Institucion         @relation(fields: [institucionId], references: [id])

  @@map("DOCENTE_INSTITUCION")
}

model Materia {
  id                 Int                    @id @default(autoincrement())
  institucionId      Int                    @map("institucion_id")
  clave              String
  nombre             String
  programaEducativo  String                 @map("programa_educativo")
  descripcion        String
  activa             Boolean
  creadoEn           DateTime               @default(now()) @map("creado_en")
  actualizadoEn      DateTime               @default(now()) @updatedAt @map("actualizado_en")
  asignaciones       AsignacionDocente[]
  institucion        Institucion            @relation(fields: [institucionId], references: [id])
  solicitudesDestino SolicitudClaseEspejo[]

  @@map("MATERIA")
}

model AsignacionDocente {
  id                   Int                    @id @default(autoincrement())
  docenteInstitucionId Int                    @map("docente_institucion_id")
  materiaId            Int                    @map("materia_id")
  periodoEscolar       String                 @map("periodo_escolar")
  docenteInstitucion   DocenteInstitucion     @relation(fields: [docenteInstitucionId], references: [id])
  materia              Materia                @relation(fields: [materiaId], references: [id])
  creadoEn             DateTime               @default(now()) @map("creado_en")
  actualizadoEn        DateTime               @default(now()) @updatedAt @map("actualizado_en")
  proyectosDocente     ProyectoDocente[]
  solicitudesOrigen    SolicitudClaseEspejo[]

  @@map("ASIGNACION_DOCENTE")
}

model SolicitudClaseEspejo {
  id                   Int                  @id @default(autoincrement())
  asignacionOrigenId   Int                  @map("asignacion_origen_id")
  institucionDestinoId Int                  @map("institucion_destino_id")
  materiaDestinoId     Int?                 @map("materia_destino_id")
  titulo               String
  objetivo             String
  fechaPropuesta       DateTime             @map("fecha_propuesta") @db.Date
  estado               String
  proyecto             ProyectoClaseEspejo?
  creadoEn             DateTime             @default(now()) @map("creado_en")
  actualizadoEn        DateTime             @default(now()) @updatedAt @map("actualizado_en")
  revisiones           RevisionSolicitud[]
  asignacionOrigen     AsignacionDocente    @relation(fields: [asignacionOrigenId], references: [id])
  institucionDestino   Institucion          @relation(fields: [institucionDestinoId], references: [id])
  materiaDestino       Materia?             @relation(fields: [materiaDestinoId], references: [id])

  @@map("SOLICITUD_CLASE_ESPEJO")
}

model RevisionSolicitud {
  id            Int                        @id @default(autoincrement())
  solicitudId   Int                        @map("solicitud_id")
  agenteId      Int                        @map("agente_id")
  etapa         String
  decision      String
  comentario    String
  creadoEn      DateTime                   @default(now()) @map("creado_en")
  actualizadoEn DateTime                   @default(now()) @updatedAt @map("actualizado_en")
  revisadaEn    DateTime                   @map("revisada_en")
  agente        AgenteInternacionalizacion @relation(fields: [agenteId], references: [id])
  solicitud     SolicitudClaseEspejo       @relation(fields: [solicitudId], references: [id])

  @@map("REVISION_SOLICITUD")
}

model ProyectoClaseEspejo {
  id            Int                    @id @default(autoincrement())
  solicitudId   Int                    @unique @map("solicitud_id")
  estado        String
  fechaInicio   DateTime               @map("fecha_inicio") @db.Date
  fechaFin      DateTime               @map("fecha_fin") @db.Date
  plataforma    String
  actividades   Actividad[]
  evaluaciones  Evaluacion[]
  evidencias    Evidencia[]
  creadoEn      DateTime               @default(now()) @map("creado_en")
  actualizadoEn DateTime               @default(now()) @updatedAt @map("actualizado_en")
  planificacion PlanificacionConjunta?
  solicitud     SolicitudClaseEspejo   @relation(fields: [solicitudId], references: [id])
  docentes      ProyectoDocente[]
  sesiones      Sesion[]

  @@map("PROYECTO_CLASE_ESPEJO")
}

model ProyectoDocente {
  id                  Int                          @id @default(autoincrement())
  proyectoId          Int                          @map("proyecto_id")
  asignacionDocenteId Int                          @map("asignacion_docente_id")
  rol                 String
  creadoEn            DateTime                     @default(now()) @map("creado_en")
  actualizadoEn       DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  participacionesPlan ParticipacionPlanificacion[]
  participacionesRep  ParticipacionReporte[]
  asignacionDocente   AsignacionDocente            @relation(fields: [asignacionDocenteId], references: [id])
  proyecto            ProyectoClaseEspejo          @relation(fields: [proyectoId], references: [id])

  @@map("PROYECTO_DOCENTE")
}

model PlanificacionConjunta {
  id                 Int                          @id @default(autoincrement())
  proyectoId         Int                          @unique @map("proyecto_id")
  objetivosAcordados String                       @map("objetivos_acordados")
  temasAcordados     String                       @map("temas_acordados")
  metodologia        String
  plataforma         String
  estado             String
  creadoEn           DateTime                     @default(now()) @map("creado_en")
  actualizadoEn      DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  participaciones    ParticipacionPlanificacion[]
  proyecto           ProyectoClaseEspejo          @relation(fields: [proyectoId], references: [id])
  reportes           ReportePlanificacion[]

  @@map("PLANIFICACION_CONJUNTA")
}

model ParticipacionPlanificacion {
  id                  Int                   @id @default(autoincrement())
  planificacionId     Int                   @map("planificacion_id")
  proyectoDocenteId   Int                   @map("proyecto_docente_id")
  estatusConfirmacion String                @map("estatus_confirmacion")
  confirmadaEn        DateTime?             @map("confirmada_en")
  creadoEn            DateTime              @default(now()) @map("creado_en")
  actualizadoEn       DateTime              @default(now()) @updatedAt @map("actualizado_en")
  planificacion       PlanificacionConjunta @relation(fields: [planificacionId], references: [id])
  proyectoDocente     ProyectoDocente       @relation(fields: [proyectoDocenteId], references: [id])

  @@map("PARTICIPACION_PLANIFICACION")
}

model ReportePlanificacion {
  id                   Int                   @id @default(autoincrement())
  planificacionId      Int                   @map("planificacion_id")
  acuerdos             String
  calendario           String
  actividadesAcordadas String                @map("actividades_acordadas")
  generadoEn           DateTime              @map("generado_en")
  creadoEn             DateTime              @default(now()) @map("creado_en")
  actualizadoEn        DateTime              @default(now()) @updatedAt @map("actualizado_en")
  planificacion        PlanificacionConjunta @relation(fields: [planificacionId], references: [id])

  @@map("REPORTE_PLANIFICACION")
}

model Sesion {
  id            Int                   @id @default(autoincrement())
  proyectoId    Int                   @map("proyecto_id")
  titulo        String
  fechaHora     DateTime              @map("fecha_hora")
  enlaceVirtual String                @map("enlace_virtual")
  estado        String
  evidencias    Evidencia[]
  reporte       ReporteClaseConjunta?
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo   @relation(fields: [proyectoId], references: [id])

  @@map("SESION")
}

model Actividad {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  titulo        String
  instrucciones String
  fechaLimite   DateTime            @map("fecha_limite") @db.Date
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])

  @@map("ACTIVIDAD")
}

model ReporteClaseConjunta {
  id                      Int                    @id @default(autoincrement())
  sesionId                Int                    @unique @map("sesion_id")
  desarrolloClase         String                 @map("desarrollo_clase")
  totalAsistentes         Int                    @map("total_asistentes")
  incidencias             String
  acuerdosSiguienteSesion String                 @map("acuerdos_siguiente_sesion")
  estado                  String
  creadoEn                DateTime               @default(now()) @map("creado_en")
  actualizadoEn           DateTime               @default(now()) @updatedAt @map("actualizado_en")
  participaciones         ParticipacionReporte[]
  sesion                  Sesion                 @relation(fields: [sesionId], references: [id])

  @@map("REPORTE_CLASE_CONJUNTA")
}

model ParticipacionReporte {
  id                Int                  @id @default(autoincrement())
  reporteClaseId    Int                  @map("reporte_clase_id")
  proyectoDocenteId Int                  @map("proyecto_docente_id")
  observaciones     String
  confirmadoEn      DateTime?            @map("confirmado_en")
  creadoEn          DateTime             @default(now()) @map("creado_en")
  actualizadoEn     DateTime             @default(now()) @updatedAt @map("actualizado_en")
  proyectoDocente   ProyectoDocente      @relation(fields: [proyectoDocenteId], references: [id])
  reporteClase      ReporteClaseConjunta @relation(fields: [reporteClaseId], references: [id])

  @@map("PARTICIPACION_REPORTE")
}

model Evidencia {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  sesionId      Int?                @map("sesion_id")
  tipo          String
  archivoUrl    String              @map("archivo_url")
  registradaEn  DateTime            @map("registrada_en")
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])
  sesion        Sesion?             @relation(fields: [sesionId], references: [id])

  @@map("EVIDENCIA")
}

model Evaluacion {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  instrumento   String
  resultado     String
  observaciones String
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])

  @@map("EVALUACION")
}
