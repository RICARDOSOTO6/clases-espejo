generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institucion {
  id                  Int                          @id @default(autoincrement())
  nombre              String
  pais                String
  codigoPais          String                       @default("") @map("codigo_pais")
  estado              String                       @default("")
  ciudad              String                       @default("")
  telefono            String                       @default("")
  correoInstitucional String                       @map("correo_institucional")
  activa              Boolean
  registroCompleto    Boolean                      @default(false) @map("registro_completo")
  /// Estado ante la CACE: PENDIENTE, APROBADA, RECHAZADA o VETADA. Las
  /// instituciones que ya existian quedan APROBADAS para no dejarlas fuera.
  estadoCace          String                       @default("APROBADA") @map("estado_cace")
  /// Motivo del rechazo o del veto (obligatorio en los dos).
  motivoCace          String                       @default("") @map("motivo_cace")
  /// Baja con historial: la institución queda inoperable pero no se borra.
  archivadaEn         DateTime?                    @map("archivada_en")
  archivadaPorUsuarioId Int?                       @map("archivada_por_usuario_id")
  motivoArchivo       String                       @default("") @map("motivo_archivo")
  /// Logo de la institución, para reconocerla en el catálogo.
  logoUrl             String?                      @map("logo_url")
  revisadaPorUsuarioId Int?                        @map("revisada_por_usuario_id")
  revisadaEn          DateTime?                    @map("revisada_en")
  revisadaPor         Usuario?                     @relation("InstitucionRevisada", fields: [revisadaPorUsuarioId], references: [id])
  creadoEn            DateTime                     @default(now()) @map("creado_en")
  actualizadoEn       DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  agentes             AgenteInternacionalizacion[]
  docentesInstitucion DocenteInstitucion[]
  materias            Materia[]
  solicitudesDestino  SolicitudClaseEspejo[]
  invitaciones        Invitacion[]
  listasAlumnos       ListaAlumnos[]
  premios             Premio[]
  solicitudesBorrado  SolicitudBorradoInstitucion[]

  @@index([estadoCace])
  @@map("INSTITUCION")
}

model Usuario {
  id              Int                         @id @default(autoincrement())
  nombres         String
  apellidoPaterno String                      @map("apellido_paterno")
  apellidoMaterno String                      @map("apellido_materno")
  dni             String                      @unique
  tipoDocumento   String                      @default("DNI") @map("tipo_documento")
  correo          String                      @unique
  passwordHash    String?                     @map("password_hash")
  /// Ruta pública de la foto de perfil (por ejemplo `/avatares/123.png`).
  fotoUrl         String?                     @map("foto_url")
  activo          Boolean                     @default(true)
  /// Se pone en `true` al crear una cuenta con contraseña provisional (por
  /// ejemplo el presidente de la CACE): el primer acceso obliga a cambiarla.
  debeCambiarPassword Boolean                @default(false) @map("debe_cambiar_password")
  /// Intentos fallidos seguidos de inicio de sesión; al llegar al máximo la
  /// cuenta queda bloqueada un rato (política de contraseñas de la Fase 1).
  intentosFallidos Int                        @default(0) @map("intentos_fallidos")
  /// Hasta cuándo está bloqueado el acceso por intentos fallidos (null = libre).
  bloqueadoHasta  DateTime?                   @map("bloqueado_hasta")
  /// Momento del último cambio de contraseña. Los tokens de sesión emitidos
  /// antes de esta marca dejan de valer (cerrar sesiones de la Fase 1).
  sesionesValidasDesde DateTime               @default(now()) @map("sesiones_validas_desde")
  /// Correo confirmado (Fase 1). Las cuentas que ya existían quedan verificadas;
  /// los registros nuevos nacen en `false` hasta abrir el enlace del correo.
  correoVerificado Boolean                    @default(true) @map("correo_verificado")
  /// Versión del aviso de privacidad aceptada (vacío = nunca aceptó).
  aceptoAvisoVersion String                   @default("") @map("acepto_aviso_version")
  /// Momento de la aceptación, para poder demostrarla.
  aceptoAvisoEn   DateTime?                   @map("acepto_aviso_en")
  recuperaciones  RecuperacionPassword[]
  verificacionesCorreo VerificacionCorreo[]
  enviosCorreo   EnvioCorreo[]
  creadoEn        DateTime                    @default(now()) @map("creado_en")
  actualizadoEn   DateTime                    @default(now()) @updatedAt @map("actualizado_en")
  agente          AgenteInternacionalizacion?
  docente         Docente?
  miembroCace     MiembroCace?
  listasAlumnos   ListaAlumnos[]
  institucionesRevisadas Institucion[] @relation("InstitucionRevisada")
  agentesConfirmados    AgenteInternacionalizacion[] @relation("AgenteConfirmado")
  configuracionCace     ConfiguracionCace[] @relation("ConfiguracionCace")
  plantillasCertificado PlantillaCertificado[] @relation("PlantillaCertificado")
  certificadosEmitidos  Certificado[] @relation("CertificadoEmitido")
  solicitudesBorradoSolicitadas SolicitudBorradoInstitucion[] @relation("SolicitudBorradoSolicitante")
  solicitudesBorradoResueltas   SolicitudBorradoInstitucion[] @relation("SolicitudBorradoResolutor")
  cambiosPresidenciaSaliente    CambioPresidencia[] @relation("CambioPresidenciaSaliente")
  cambiosPresidenciaEntrante    CambioPresidencia[] @relation("CambioPresidenciaEntrante")

  @@map("USUARIO")
}

model Invitacion {
  id             Int         @id @default(autoincrement())
  correo         String
  numeroEmpleado String      @map("numero_empleado")
  institucionId  Int         @map("institucion_id")
  token          String      @unique
  expiracion     DateTime
  usadaEn        DateTime?   @map("usada_en")
  creadoEn       DateTime    @default(now()) @map("creado_en")
  institucion    Institucion @relation(fields: [institucionId], references: [id])

  @@index([institucionId])
  @@index([correo])
  @@map("INVITACION")
}

model AgenteInternacionalizacion {
  id            Int                 @id @default(autoincrement())
  usuarioId     Int                 @unique @map("usuario_id")
  institucionId Int                 @map("institucion_id")
  cargo         String
  /// Cuando un agente se une a una institucion **ya aprobada**, su alta la
  /// confirma el agente de esa institucion (no el presidente): hasta entonces
  /// queda en null. El agente fundador nace confirmado y de la institucion se
  /// encarga el presidente.
  confirmadoEn            DateTime? @map("confirmado_en")
  confirmadoPorUsuarioId  Int?      @map("confirmado_por_usuario_id")
  confirmadoPor           Usuario?  @relation("AgenteConfirmado", fields: [confirmadoPorUsuarioId], references: [id])
  institucion   Institucion         @relation(fields: [institucionId], references: [id])
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  revisiones    RevisionSolicitud[]

  @@index([institucionId])
  @@map("AGENTE_INTERNACIONALIZACION")
}

model Docente {
  id             Int                  @id @default(autoincrement())
  usuarioId      Int                  @unique @map("usuario_id")
  gradoAcademico String               @map("grado_academico")
  especialidad   String
  usuario        Usuario              @relation(fields: [usuarioId], references: [id])
  creadoEn       DateTime             @default(now()) @map("creado_en")
  actualizadoEn  DateTime             @default(now()) @updatedAt @map("actualizado_en")
  instituciones  DocenteInstitucion[]

  @@map("DOCENTE")
}

model DocenteInstitucion {
  id             Int                 @id @default(autoincrement())
  docenteId      Int                 @map("docente_id")
  institucionId  Int                 @map("institucion_id")
  numeroEmpleado String              @map("numero_empleado")
  activo         Boolean
  creadoEn       DateTime            @default(now()) @map("creado_en")
  actualizadoEn  DateTime            @default(now()) @updatedAt @map("actualizado_en")
  asignaciones   AsignacionDocente[]
  docente        Docente             @relation(fields: [docenteId], references: [id])
  institucion    Institucion         @relation(fields: [institucionId], references: [id])

  @@index([institucionId])
  @@unique([docenteId, institucionId], map: "docente_institucion_unico")
  @@map("DOCENTE_INSTITUCION")
}

model Materia {
  id                 Int                    @id @default(autoincrement())
  institucionId      Int                    @map("institucion_id")
  clave              String
  nombre             String
  programaEducativo  String                 @map("programa_educativo")
  descripcion        String
  activa             Boolean
  creadoEn           DateTime               @default(now()) @map("creado_en")
  actualizadoEn      DateTime               @default(now()) @updatedAt @map("actualizado_en")
  asignaciones       AsignacionDocente[]
  institucion        Institucion            @relation(fields: [institucionId], references: [id])
  solicitudesDestino SolicitudClaseEspejo[]

  @@index([institucionId])
  @@unique([institucionId, clave], map: "materia_institucion_clave_unica")
  @@map("MATERIA")
}

model AsignacionDocente {
  id                   Int                    @id @default(autoincrement())
  docenteInstitucionId Int                    @map("docente_institucion_id")
  materiaId            Int                    @map("materia_id")
  periodoEscolar       String                 @map("periodo_escolar")
  docenteInstitucion   DocenteInstitucion     @relation(fields: [docenteInstitucionId], references: [id])
  materia              Materia                @relation(fields: [materiaId], references: [id])
  creadoEn             DateTime               @default(now()) @map("creado_en")
  actualizadoEn        DateTime               @default(now()) @updatedAt @map("actualizado_en")
  proyectosDocente     ProyectoDocente[]
  solicitudesOrigen    SolicitudClaseEspejo[] @relation("SolicitudOrigen")
  solicitudesDestino   SolicitudClaseEspejo[] @relation("SolicitudDestino")

  @@index([docenteInstitucionId])
  @@index([materiaId])
  @@unique([docenteInstitucionId, materiaId, periodoEscolar], map: "asignacion_docente_periodo_unica")
  @@map("ASIGNACION_DOCENTE")
}

model SolicitudClaseEspejo {
  id                   Int                  @id @default(autoincrement())
  asignacionOrigenId   Int                  @map("asignacion_origen_id")
  asignacionDestinoId  Int?                 @map("asignacion_destino_id")
  institucionDestinoId Int                  @map("institucion_destino_id")
  materiaDestinoId     Int?                 @map("materia_destino_id")
  titulo               String
  objetivo             String
  fechaPropuesta       DateTime             @map("fecha_propuesta") @db.Date
  estado               String
  proyecto             ProyectoClaseEspejo?
  creadoEn             DateTime             @default(now()) @map("creado_en")
  actualizadoEn        DateTime             @default(now()) @updatedAt @map("actualizado_en")
  revisiones           RevisionSolicitud[]
  asignacionOrigen     AsignacionDocente    @relation("SolicitudOrigen", fields: [asignacionOrigenId], references: [id])
  asignacionDestino    AsignacionDocente?   @relation("SolicitudDestino", fields: [asignacionDestinoId], references: [id])
  institucionDestino   Institucion          @relation(fields: [institucionDestinoId], references: [id])
  materiaDestino       Materia?             @relation(fields: [materiaDestinoId], references: [id])

  @@index([institucionDestinoId, estado])
  @@index([asignacionOrigenId])
  @@index([asignacionDestinoId])
  @@index([materiaDestinoId])
  @@index([fechaPropuesta])
  @@map("SOLICITUD_CLASE_ESPEJO")
}

model RevisionSolicitud {
  id            Int                        @id @default(autoincrement())
  solicitudId   Int                        @map("solicitud_id")
  agenteId      Int                        @map("agente_id")
  etapa         String
  decision      String
  comentario    String
  creadoEn      DateTime                   @default(now()) @map("creado_en")
  actualizadoEn DateTime                   @default(now()) @updatedAt @map("actualizado_en")
  revisadaEn    DateTime                   @map("revisada_en")
  agente        AgenteInternacionalizacion @relation(fields: [agenteId], references: [id])
  solicitud     SolicitudClaseEspejo       @relation(fields: [solicitudId], references: [id])

  @@index([solicitudId])
  @@index([agenteId])
  @@map("REVISION_SOLICITUD")
}

model ProyectoClaseEspejo {
  id            Int                    @id @default(autoincrement())
  solicitudId   Int                    @unique @map("solicitud_id")
  estado        String
  fechaInicio   DateTime               @map("fecha_inicio") @db.Date
  fechaFin      DateTime               @map("fecha_fin") @db.Date
  plataforma    String
  actividades   Actividad[]
  evaluaciones  Evaluacion[]
  evidencias    Evidencia[]
  creadoEn      DateTime               @default(now()) @map("creado_en")
  actualizadoEn DateTime               @default(now()) @updatedAt @map("actualizado_en")
  planificacion PlanificacionConjunta?
  solicitud     SolicitudClaseEspejo   @relation(fields: [solicitudId], references: [id])
  docentes      ProyectoDocente[]
  sesiones      Sesion[]
  mensajes      Mensaje[]
  listasAlumnos ListaAlumnos[]
  certificados  Certificado[]

  @@index([estado])
  @@map("PROYECTO_CLASE_ESPEJO")
}

model ProyectoDocente {
  id                  Int                          @id @default(autoincrement())
  proyectoId          Int                          @map("proyecto_id")
  asignacionDocenteId Int                          @map("asignacion_docente_id")
  rol                 String
  creadoEn            DateTime                     @default(now()) @map("creado_en")
  actualizadoEn       DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  participacionesPlan ParticipacionPlanificacion[]
  participacionesRep  ParticipacionReporte[]
  mensajes            Mensaje[]
  asignacionDocente   AsignacionDocente            @relation(fields: [asignacionDocenteId], references: [id])
  proyecto            ProyectoClaseEspejo          @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId])
  @@index([asignacionDocenteId])
  @@map("PROYECTO_DOCENTE")
}

model Mensaje {
  id                Int                 @id @default(autoincrement())
  proyectoId        Int                 @map("proyecto_id")
  proyectoDocenteId Int                 @map("proyecto_docente_id")
  contenido         String
  creadoEn          DateTime            @default(now()) @map("creado_en")
  proyecto          ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])
  autor             ProyectoDocente     @relation(fields: [proyectoDocenteId], references: [id])

  @@index([proyectoId, creadoEn])
  @@index([proyectoDocenteId])
  @@map("MENSAJE")
}

model PlanificacionConjunta {
  id                 Int                          @id @default(autoincrement())
  proyectoId         Int                          @unique @map("proyecto_id")
  objetivosAcordados String                       @map("objetivos_acordados")
  temasAcordados     String                       @map("temas_acordados")
  metodologia        String
  plataforma         String
  estado             String
  creadoEn           DateTime                     @default(now()) @map("creado_en")
  actualizadoEn      DateTime                     @default(now()) @updatedAt @map("actualizado_en")
  participaciones    ParticipacionPlanificacion[]
  proyecto           ProyectoClaseEspejo          @relation(fields: [proyectoId], references: [id])
  reportes           ReportePlanificacion[]

  @@map("PLANIFICACION_CONJUNTA")
}

model ParticipacionPlanificacion {
  id                  Int                   @id @default(autoincrement())
  planificacionId     Int                   @map("planificacion_id")
  proyectoDocenteId   Int                   @map("proyecto_docente_id")
  estatusConfirmacion String                @map("estatus_confirmacion")
  confirmadaEn        DateTime?             @map("confirmada_en")
  creadoEn            DateTime              @default(now()) @map("creado_en")
  actualizadoEn       DateTime              @default(now()) @updatedAt @map("actualizado_en")
  planificacion       PlanificacionConjunta @relation(fields: [planificacionId], references: [id])
  proyectoDocente     ProyectoDocente       @relation(fields: [proyectoDocenteId], references: [id])

  @@index([planificacionId])
  @@index([proyectoDocenteId])
  @@map("PARTICIPACION_PLANIFICACION")
}

model ReportePlanificacion {
  id              Int                   @id @default(autoincrement())
  planificacionId Int                   @unique @map("planificacion_id")
  vistoBueno      Boolean               @default(true) @map("visto_bueno")
  observaciones   String                @default("") @map("observaciones")
  generadoEn      DateTime              @map("generado_en")
  creadoEn        DateTime              @default(now()) @map("creado_en")
  actualizadoEn   DateTime              @default(now()) @updatedAt @map("actualizado_en")
  planificacion   PlanificacionConjunta @relation(fields: [planificacionId], references: [id])

  @@map("REPORTE_PLANIFICACION")
}

model Sesion {
  id            Int                   @id @default(autoincrement())
  proyectoId    Int                   @map("proyecto_id")
  titulo        String
  fechaHora     DateTime              @map("fecha_hora")
  enlaceVirtual String                @map("enlace_virtual")
  estado        String
  evidencias    Evidencia[]
  reporte       ReporteClaseConjunta?
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo   @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId, fechaHora])
  @@index([fechaHora])
  @@map("SESION")
}

model Actividad {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  titulo        String
  instrucciones String
  fechaLimite   DateTime            @map("fecha_limite") @db.Date
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId, fechaLimite])
  @@index([fechaLimite])
  @@map("ACTIVIDAD")
}

model ReporteClaseConjunta {
  id                      Int                    @id @default(autoincrement())
  sesionId                Int                    @unique @map("sesion_id")
  desarrolloClase         String                 @map("desarrollo_clase")
  totalAsistentes         Int                    @map("total_asistentes")
  incidencias             String
  acuerdosSiguienteSesion String                 @map("acuerdos_siguiente_sesion")
  estado                  String
  creadoEn                DateTime               @default(now()) @map("creado_en")
  actualizadoEn           DateTime               @default(now()) @updatedAt @map("actualizado_en")
  participaciones         ParticipacionReporte[]
  sesion                  Sesion                 @relation(fields: [sesionId], references: [id])

  @@map("REPORTE_CLASE_CONJUNTA")
}

model ParticipacionReporte {
  id                Int                  @id @default(autoincrement())
  reporteClaseId    Int                  @map("reporte_clase_id")
  proyectoDocenteId Int                  @map("proyecto_docente_id")
  observaciones     String
  confirmadoEn      DateTime?            @map("confirmado_en")
  creadoEn          DateTime             @default(now()) @map("creado_en")
  actualizadoEn     DateTime             @default(now()) @updatedAt @map("actualizado_en")
  proyectoDocente   ProyectoDocente      @relation(fields: [proyectoDocenteId], references: [id])
  reporteClase      ReporteClaseConjunta @relation(fields: [reporteClaseId], references: [id])

  @@index([reporteClaseId])
  @@index([proyectoDocenteId])
  @@map("PARTICIPACION_REPORTE")
}

model Evidencia {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  sesionId      Int?                @map("sesion_id")
  tipo          String
  /// Archivo subido (obligatorio si no hay `enlaceUrl`).
  archivoUrl    String?             @map("archivo_url")
  /// Enlace externo de la lista blanca (obligatorio si no hay archivo).
  enlaceUrl     String?             @map("enlace_url")
  registradaEn  DateTime            @map("registrada_en")
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])
  sesion        Sesion?             @relation(fields: [sesionId], references: [id])

  @@index([proyectoId])
  @@index([sesionId])
  @@map("EVIDENCIA")
}

model Evaluacion {
  id            Int                 @id @default(autoincrement())
  proyectoId    Int                 @map("proyecto_id")
  instrumento   String
  resultado     String
  observaciones String
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @default(now()) @updatedAt @map("actualizado_en")
  proyecto      ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId])
  @@map("EVALUACION")
}

/// Lista de alumnos de una clase espejo, una por institución participante.
/// El docente sube la de su institución; con ella se emiten los certificados.
model ListaAlumnos {
  id                 Int                 @id @default(autoincrement())
  proyectoId         Int                 @map("proyecto_id")
  institucionId      Int                 @map("institucion_id")
  subidaPorUsuarioId Int                 @map("subida_por_usuario_id")
  /// De dónde salió la lista: EXCEL, CSV o PEGADO.
  origen             String
  /// Declaración de que se tiene base legal o consentimiento de los alumnos.
  consentimientoVersion String          @default("") @map("consentimiento_version")
  consentimientoEn   DateTime?           @map("consentimiento_en")
  creadoEn           DateTime            @default(now()) @map("creado_en")
  actualizadoEn      DateTime            @default(now()) @updatedAt @map("actualizado_en")
  alumnos            Alumno[]
  proyecto           ProyectoClaseEspejo @relation(fields: [proyectoId], references: [id])
  institucion        Institucion         @relation(fields: [institucionId], references: [id])
  subidaPor          Usuario             @relation(fields: [subidaPorUsuarioId], references: [id])

  @@unique([proyectoId, institucionId])
  @@index([subidaPorUsuarioId])
  @@map("LISTA_ALUMNOS")
}

/// Un alumno de la lista. Solo el nombre es obligatorio: la matrícula sirve
/// para distinguir homónimos y el correo para enviarle su certificado.
model Alumno {
  id            Int         @id @default(autoincrement())
  listaId       Int         @map("lista_id")
  nombre        String
  matricula     String      @default("")
  correo        String      @default("")
  /// Posición en la lista, para que el orden sea el que subió el docente.
  orden         Int
  /// Permite dejar a alguien fuera sin borrarlo de la lista.
  incluido      Boolean     @default(true)
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @default(now()) @updatedAt @map("actualizado_en")
  lista         ListaAlumnos @relation(fields: [listaId], references: [id], onDelete: Cascade)
  certificados  Certificado[]

  @@index([listaId])
  @@map("ALUMNO")
}

/// Miembro de la CACE: presidencia, suplencia o secretaría. Los permisos salen
/// del `cargo` (ver `common/capacidades.ts`), y el suplente es otra fila con el
/// mismo cargo: por eso no es una columna del usuario, sino una relación.
model MiembroCace {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @unique @map("usuario_id")
  /// PRESIDENTE, SUPLENTE o SECRETARIA.
  cargo         String
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("MIEMBRO_CACE")
}

/// Datos de identidad de la CACE (una sola fila): textos, logo y tema visual.
/// El presidente los edita; se leen para pintar la aplicación.
model ConfiguracionCace {
  id                      Int      @id @default(autoincrement())
  lema                    String   @default("")
  descripcion             String   @default("")
  logoUrl                 String?  @map("logo_url")
  /// Tema visual de una lista corta (no color libre, para no romper el contraste).
  tema                    String   @default("AZUL")
  /// Días mínimos de antelación para proponer una clase (8 por defecto).
  diasMinimosPropuesta    Int      @default(8) @map("dias_minimos_propuesta")
  /// Días de antelación con los que se debe responder (7 por defecto).
  diasRevision            Int      @default(7) @map("dias_revision")
  actualizadoPorUsuarioId Int?     @map("actualizado_por_usuario_id")
  actualizadoEn           DateTime @default(now()) @updatedAt @map("actualizado_en")
  actualizadoPor          Usuario? @relation("ConfiguracionCace", fields: [actualizadoPorUsuarioId], references: [id])

  @@map("CONFIGURACION_CACE")
}

/// Paises que forman la comunidad CACE. Antes eran una lista fija en el frontend;
/// ahora los mantiene el presidente.
model PaisComunidad {
  id            Int      @id @default(autoincrement())
  /// Codigo ISO de dos letras, que es lo que arma la bandera.
  codigo        String   @unique
  nombre        String
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("PAIS_COMUNIDAD")
}

/// Premios y reconocimientos de la CACE, que el presidente publica.
model Premio {
  tipo          String       @default("RECONOCIMIENTO")
  id            Int          @id @default(autoincrement())
  titulo        String
  descripcion   String       @default("")
  anio          Int          @map("anio")
  otorgadoA     String       @map("otorgado_a")
  fuenteNombre  String       @default("") @map("fuente_nombre")
  fuenteUrl     String?      @map("fuente_url")
  institucionId Int?         @map("institucion_id")
  imagenUrl     String?      @map("imagen_url")
  /// El certificado del premio: es el documento que se exhibe y se descarga,
  /// también puede acreditarse mediante la fuente oficial registrada.
  certificadoUrl    String?      @map("certificado_url")
  /// Nombre del archivo del certificado, para ofrecerlo al descargarlo.
  certificadoNombre String       @default("") @map("certificado_nombre")
  orden         Int          @default(0)
  publicado     Boolean      @default(false)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @default(now()) @updatedAt @map("actualizado_en")
  institucion   Institucion? @relation(fields: [institucionId], references: [id])

  @@index([institucionId])
  @@index([publicado])
  @@map("PREMIO")
}

/// Plantilla del certificado, **versionada**: al cambiarla se crea una version
/// nueva, para que los certificados ya emitidos no cambien nunca.
model PlantillaCertificado {
  id                 Int      @id @default(autoincrement())
  version            Int      @default(1)
  activa             Boolean  @default(false)
  fondoUrl           String?  @map("fondo_url")
  anchoPx            Int      @default(2480) @map("ancho_px")
  altoPx             Int      @default(1748) @map("alto_px")
  /// Posicion y estilo de cada dato del certificado (JSON).
  campos             Json
  /// Textos legales del certificado (JSON).
  textosLegales      Json     @map("textos_legales")
  /// Nombre de quien firma, que es el presidente de la CACE.
  firmaNombre        String   @default("") @map("firma_nombre")
  creadaPorUsuarioId Int?     @map("creada_por_usuario_id")
  creadoEn           DateTime @default(now()) @map("creado_en")
  actualizadoEn      DateTime @default(now()) @updatedAt @map("actualizado_en")
  creadaPor          Usuario? @relation("PlantillaCertificado", fields: [creadaPorUsuarioId], references: [id])
  certificados       Certificado[]

  @@map("PLANTILLA_CERTIFICADO")
}

/// Un certificado emitido. El PDF se guarda tal como se emitio: cambiar la
/// plantilla despues no lo altera.
model Certificado {
  id                  Int                  @id @default(autoincrement())
  folio               String               @unique
  alumnoId            Int                  @map("alumno_id")
  proyectoId          Int                  @map("proyecto_id")
  plantillaId         Int                  @map("plantilla_id")
  emitidoPorUsuarioId Int?                 @map("emitido_por_usuario_id")
  emitidoEn           DateTime             @default(now()) @map("emitido_en")
  archivoPdf          String               @map("archivo_pdf")
  hashSha256          String               @default("") @map("hash_sha256")
  /// EMITIDO o ANULADO (al reemitir se anula el anterior y se deja el motivo).
  estado              String               @default("EMITIDO")
  anuladoMotivo       String               @default("") @map("anulado_motivo")
  /// Cuando se le mando por correo al alumno, y a que direccion.
  enviadoEn           DateTime?            @map("enviado_en")
  enviadoA            String               @default("") @map("enviado_a")
  alumno              Alumno               @relation(fields: [alumnoId], references: [id])
  proyecto            ProyectoClaseEspejo  @relation(fields: [proyectoId], references: [id])
  plantilla           PlantillaCertificado @relation(fields: [plantillaId], references: [id])
  emitidoPor          Usuario?             @relation("CertificadoEmitido", fields: [emitidoPorUsuarioId], references: [id])
  envios              EnvioCorreo[]

  @@index([proyectoId, estado])
  @@index([alumnoId])
  @@index([plantillaId])
  @@map("CERTIFICADO")
}

/// Peticion de la secretaria para borrar definitivamente una institucion
/// rechazada. La aprueba el presidente, y el borrado lo ejecuta la aprobacion:
/// asi queda registrado quien lo autorizo, que es lo que pidio el usuario.
model SolicitudBorradoInstitucion {
  id                     Int         @id @default(autoincrement())
  institucionId          Int?        @map("institucion_id")
  solicitadaPorUsuarioId Int         @map("solicitada_por_usuario_id")
  motivo                 String      @default("")
  /// PENDIENTE, APROBADA o RECHAZADA.
  estado                 String      @default("PENDIENTE")
  resueltaPorUsuarioId   Int?        @map("resuelta_por_usuario_id")
  resueltaEn             DateTime?   @map("resuelta_en")
  creadoEn               DateTime    @default(now()) @map("creado_en")
  actualizadoEn          DateTime    @default(now()) @updatedAt @map("actualizado_en")
  institucion            Institucion? @relation(fields: [institucionId], references: [id])
  solicitadaPor          Usuario     @relation("SolicitudBorradoSolicitante", fields: [solicitadaPorUsuarioId], references: [id])
  resueltaPor            Usuario?    @relation("SolicitudBorradoResolutor", fields: [resueltaPorUsuarioId], references: [id])

  @@index([institucionId])
  @@index([estado])
  @@map("SOLICITUD_BORRADO_INSTITUCION")
}

/// Registro de los cambios de presidencia. La presidencia **no se borra ni se
/// desactiva** (es una figura central): se transmite. Quien deja el cargo queda
/// como suplente, que conserva las capacidades, y aqui queda quien lo autorizo.
model CambioPresidencia {
  id                Int      @id @default(autoincrement())
  salienteUsuarioId Int      @map("saliente_usuario_id")
  entranteUsuarioId Int      @map("entrante_usuario_id")
  motivo            String   @default("")
  creadoEn          DateTime @default(now()) @map("creado_en")
  saliente          Usuario  @relation("CambioPresidenciaSaliente", fields: [salienteUsuarioId], references: [id])
  entrante          Usuario  @relation("CambioPresidenciaEntrante", fields: [entranteUsuarioId], references: [id])

  @@map("CAMBIO_PRESIDENCIA")
}

/// Enlace de recuperación de contraseña (Fase 1). Se guarda el **hash** del
/// token, nunca el token en claro: una copia de la base no sirve para
/// restablecer contraseñas. Cada enlace es de un solo uso y caduca.
model RecuperacionPassword {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash")
  expira     DateTime
  usadoEn    DateTime? @map("usado_en")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("RECUPERACION_PASSWORD")
}

/// Confirmación de correo (Fase 1): sirve tanto para verificar la cuenta recién
/// registrada como para confirmar una dirección nueva al cambiar de correo. Se
/// guarda el hash del token, nunca el token en claro.
model VerificacionCorreo {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  /// Correo que se está confirmando (el nuevo, cuando es un cambio).
  correo    String
  tokenHash String    @unique @map("token_hash")
  expira    DateTime
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([correo])
  @@map("VERIFICACION_CORREO")
}
/// Cola de correo de la Fase 2. Cada fila es un correo pendiente de salir: los
/// endpoints de envio solo encolan y responden al instante con un `loteId`; el
/// worker periodico se encarga de mandarlos, reintentar los fallos con espera
/// creciente y dejar registro del motivo. Asi, matar el proceso a mitad no
/// pierde envios: las filas siguen en `PENDIENTE` hasta que salgan.
model EnvioCorreo {
  id                     Int          @id @default(autoincrement())
  /// Identificador comun de todos los correos pedidos en la misma accion.
  loteId                 String       @map("lote_id")
  /// Quien lo pidio (para que solo esa persona vea el progreso del lote).
  solicitadoPorUsuarioId Int          @map("solicitado_por_usuario_id")
  destinatario           String
  asunto                 String
  cuerpoTexto            String       @map("cuerpo_texto")
  cuerpoHtml             String       @map("cuerpo_html")
  adjuntoNombre          String?      @map("adjunto_nombre")
  /// Ruta en disco del adjunto (certificados): el archivo no se borra.
  adjuntoRuta            String?      @map("adjunto_ruta")
  /// Adjunto pequeno en base64 (el .ics del calendario).
  adjuntoBase64          String?      @map("adjunto_base64")
  /// PENDIENTE, ENVIADO o FALLIDO.
  estado                 String       @default("PENDIENTE")
  /// Fallos acumulados. A los MAX_INTENTOS la fila pasa a FALLIDO.
  intentos               Int          @default(0)
  /// Cuando toca el siguiente intento (espera creciente entre reintentos).
  proximoIntento         DateTime     @default(now()) @map("proximo_intento")
  ultimoError            String       @default("") @map("ultimo_error")
  enviadoEn              DateTime?    @map("enviado_en")
  fallidoEn              DateTime?    @map("fallido_en")
  /// Certificado que actualiza al salir (marca `enviadoEn`/`enviadoA`).
  certificadoId          Int?         @map("certificado_id")
  creadoEn               DateTime     @default(now()) @map("creado_en")
  actualizadoEn          DateTime     @default(now()) @updatedAt @map("actualizado_en")
  solicitadoPor          Usuario      @relation(fields: [solicitadoPorUsuarioId], references: [id])
  certificado            Certificado? @relation(fields: [certificadoId], references: [id], onDelete: SetNull)

  @@index([estado, proximoIntento])
  @@index([loteId])
  @@index([solicitadoPorUsuarioId])
  @@map("ENVIO_CORREO")
}
