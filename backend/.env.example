# ============================================================================
# Variables de entorno de Clases Conjuntas (backend)
#
# Copia este archivo a `.env` y rellena los valores reales:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# `.env` NO se versiona. Este `.env.example` SÍ: es la lista canónica de lo que
# el código lee y sirve para montar un servidor desde cero sin adivinar nombres.
# ============================================================================

# --- Base de datos (obligatoria) -------------------------------------------
# Cadena de conexión de PostgreSQL que usa Prisma.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/ClasesconjuntasBD?schema=public"

# --- Autenticación (obligatoria) -------------------------------------------
# Firma los tokens de sesión y, con el mismo secreto y HMAC-SHA256, deriva el
# código de verificación de los certificados. Mínimo 32 bytes.
# La aplicación NO arranca si falta o mide menos.
# Genera uno con: openssl rand -hex 32
# ⚠ Cambiarlo invalida las sesiones y los códigos de verificación ya impresos
# en certificados.
JWT_SECRET="PEGA_AQUI_EL_RESULTADO_DE_OPENSSL_RAND_HEX_32"
JWT_EXPIRES_IN="1d"
INVITATION_EXPIRES_IN="7d"

# --- URLs públicas ----------------------------------------------------------
# Origen del frontend: se usa para los enlaces de activación y como origen
# permitido en CORS (admite varias separadas por coma).
FRONTEND_URL="http://localhost:3000"
# Base del enlace del QR del certificado: {URL_PUBLICA}/verificar/{folio}?c=...
# Si falta, se usa http://localhost:3000. No lee cabeceras de la petición, así
# que con túnel o dominio real hay que ponerla a mano (ver docs/README.md).
URL_PUBLICA="http://localhost:3000"

# Los certificados llevan marca DEMO y no se presentan como oficiales.
# Cambiar a "false" solo cuando la CACE autorice la plantilla y el uso oficial.
CERTIFICADO_MODO_DEMO="true"

# --- Correo saliente (Nodemailer / SMTP) ------------------------------------
# Invitaciones, avisos de la CACE, altas de agentes y certificados a alumnos.
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@clasesespejo.local"

# --- Presidencia de la CACE (opcional pero necesaria en una instalación nueva)
# Si al arrancar no existe ninguna presidencia, se crea la cuenta de este correo
# con contraseña provisional (cambio obligatorio al entrar) y se le envía.
# Sin esta variable no se da de alta a nadie automáticamente.
PRESIDENTE_CORREO="presidencia@ejemplo.org"

# --- Opcionales -------------------------------------------------------------
# Puerto del backend (por defecto 3000).
#PORT="3000"
# Días de antelación con los que debe responderse una solicitud antes de la
# fecha propuesta; pasado ese plazo caduca sola (por defecto 7).
#REVISION_DIAS_ANTELACION="7"
# Hosts (admite *.dominio) aceptados para deducir la URL pública de la petición.
# Vacío = se acepta cualquier host válido. Ver docs/README.md.
#URLS_PERMITIDAS=""

# --- Alertas de salud (opcionales) -----------------------------------------
# El temporizador clasesespejo-salud.timer ejecuta scripts/verificar-salud.js.
# Configura un webhook (Slack, Discord, Telegram o endpoint propio) para que
# alguien reciba el aviso cuando /health falle.
#ALERTA_WEBHOOK_URL=""
#ALERTA_WEBHOOK_TOKEN=""
#ALERTA_COOLDOWN_MIN="30"

# --- Solo para los guiones de verificación de backend/scripts/ --------------
# No los necesita el servidor. Están documentados en docs/guias/trabajo-en-el-codigo.md.
#APP_URL="http://localhost:3000"
#CACE_PASSWORD=""
#PASSWORD_DEMO=""
#PROYECTO_ID=""
#FOLIO=""
#CARPETA_CAPTURAS=""
#CDP_URL="http://localhost:9222"
#ESPERA_MS="2500"

# Opcional: cada cuantos milisegundos vacia la cola el worker (60000 = un minuto).
#ENVIOS_INTERVALO_MS="60000"

# Opcional: remitente propio para los certificados (si el proveedor lo permite).
#MAIL_FROM_CERTIFICADOS=""
